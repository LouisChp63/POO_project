	-	resultatCombat : bool
	-	combatTermine : bool
	-	joueurCouche : bool
	- ennemiCouche : bool
	
	+ Combat(Joueur&, Ennemi&)
	+ ~Combat()
		
	- initCombat()
	- tourEnnemi(
	- tourJoueur()
	- evaluerResultat()

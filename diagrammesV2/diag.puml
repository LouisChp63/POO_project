' ===================== PLATEAU =====================
class Plateau {
    - taille : int
    - cases : vector<CaseType>
    - ennemis : vector<Ennemi*>
    - objets : vector<Objet>
    
    + Plateau(int t)
		+ ~Plateau()
    + getTaille() : int
    + getEnnemis() : const vector<Ennemi*>&
    + isValib(int) : bool
    + hasEnnemi(int) : bool
    + hasObj(int) : bool 
		
		+ clearCase(int)
		+ getEnnemi(int) : Ennemi*
    + prendreObjet(int) : Objet
}

Plateau "1" *-- "*" Ennemi
Plateau --> CaseType


@startuml
skinparam classAttributeIconSize 0

top to bottom direction
skinparam wrapWidth 200


' ===================== ENUMS =====================
enum Couleur {
    Coeur
    Carreau
    Trefle
    Pique
}

enum Valeur {
    Deux = 2
    Trois = 3
    Quatre = 4
    Cinq
    Six
    Sept
    Huit
    Neuf
    Dix
    Valet
    Dame
    Roi
    As = 14
}

enum CaseType {
    Vide
    Ennemi
    Objet
}

' ===================== CARTE / HAND =====================
class Carte {
    - couleur : Couleur
    - valeur : Valeur
    
    + Carte(valeur, couleur)
    + ~Carte()
    + getValeurInt() : Valeur
    + getValeurInt() : int
    + getCouleur() : Couleur
    + afficherASCII() 
    
    + operator==(const Carte& other) : bool;
    + operator>(const Carte& other) : bool;
    + operator<(const Carte& other) : bool;
}

class Hand {
    - cartes : vector<Carte>
    + taille() : int
    
    + Hand()
    + ~Hand()
    + ajouterCarte(Carte&)
    + contient(Carte&) : bool
    + afficherAscii();
    
    + defausserCarte(int) : int
    + sort()
    + evaluerMain() : int
    +	StrEvaluerMain(int) : string
    + clear()
    + getCartes() : vector<Carte>&;
}

abstract Jeux {
    # cartes : vector<Carte>
    
    + ~Jeux()
    + virtual reset()
		+ virtual construireDeck()
    + melanger()
    + piocher() : Carte
    + taille() : int;
}

class JeuStandard{
		- construireDeck() override

		+ JeuStandard();
		+ reset() override;
}
class JeuRouge{
		- construireDeck() override

		+ JeuRouge();
		+ reset() override;
}

class JeuVoleuse{
		- construireDeck() override

		+ JeuVoleuse();
		+ reset() override;
}

Carte -- Couleur
Carte -- Valeur
Hand "1" o-- "5" Carte
Jeux "1" *-- "*" Carte
Joueur"1" *-- "1" Jeux
Jeux <|-- JeuStandard
Jeux <|-- JeuRouge
Jeux <|-- JeuVoleuse

